rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Solo archivos dentro de /reports/
    match /reports/{fileName} {

      // Cualquier usuario autenticado puede leer (descargar) los informes.
      // Se admite cualquier tipo de archivo: los formatos con visor se muestran
      // inline y el resto se descarga; las reglas no restringen por extensión.
      allow read: if request.auth != null;

      // Solo el admin puede subir o eliminar archivos
      // Se verifica el rol en Firestore
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Documentos subidos por los usuarios cliente: cada uno en su propia carpeta.
    // El dueño (uid de la ruta) puede leer/escribir/borrar los suyos; el admin, todos.
    match /clientDocs/{uid}/{fileName} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
