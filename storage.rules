rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin = rol en Firestore (users/{uid}.role).
    function isAdminSt() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Solo archivos dentro de /reports/
    match /reports/{fileName} {

      // Lectura (getDownloadURL): el admin, o un cliente que tiene el informe en
      // su acceso efectivo. Cada objeto lleva en su metadata personalizada el id
      // de su doc en Firestore (metadata.reportId, lo pone el portal al subir o
      // reescribir), y se cruza con accesoEfectivo/{uid}.reportIds: directos +
      // los de sus carpetas, ya expandidos por la Cloud Function (las reglas de
      // Storage leen como mucho 2 documentos: users y accesoEfectivo, y no
      // pueden recorrer el árbol). Un archivo sin etiqueta solo lo lee el admin.
      // Se admite cualquier tipo de archivo; las reglas no restringen por extensión.
      allow read: if request.auth != null && (
        isAdminSt() ||
        (resource.metadata.reportId is string &&
         firestore.exists(/databases/(default)/documents/accesoEfectivo/$(request.auth.uid)) &&
         resource.metadata.reportId in
           firestore.get(/databases/(default)/documents/accesoEfectivo/$(request.auth.uid)).data.get('reportIds', []))
      );

      // Solo el admin puede subir o eliminar archivos
      allow write: if isAdminSt();
    }

    // Documentos subidos por los usuarios cliente: cada uno en su propia carpeta.
    // El dueño (uid de la ruta) puede leer/escribir/borrar los suyos; el admin, todos.
    match /clientDocs/{uid}/{fileName} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
