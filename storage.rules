rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Solo archivos dentro de /reports/
    match /reports/{fileName} {

      // Cualquier usuario autenticado puede leer (descargar) los HTMLs
      allow read: if request.auth != null;

      // Solo el admin puede subir o eliminar archivos
      // Se verifica el rol en Firestore
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
