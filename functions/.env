# Variables de entorno de las Cloud Functions (NO secretas: se versionan).
# La contraseña de aplicación del SMTP NO va acá: vive en Secret Manager
# (SMTP_PASSWORD). Ver docs/DESPLIEGUE_alta_usuarios_correo.md.

# Región de las funciones: la MISMA que la de Firestore del proyecto y que
# FUNCTIONS_REGION en index.html.
REGION=us-central1

# URL del portal que va en los correos y a donde vuelve el usuario después de
# fijar su contraseña (su dominio tiene que estar autorizado en Authentication).
PORTAL_URL=https://portal-informes-ec.web.app

# SMTP de Google Workspace
SMTP_USUARIO=notificaciones@equipos.com.uy
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Cupo diario de correos para ESTE portal (Workspace: 2.000/día por cuenta,
# compartida con paneles; el resto queda para paneles).
CORREO_CUPO_DIARIO=1500

# Días que se conserva el registro de envíos (mailLog) — TTL de Firestore.
CORREO_DIAS_REGISTRO=90

# Tope de "¿Olvidaste tu contraseña?" por dirección y por hora.
RESTABLECER_POR_HORA=3
