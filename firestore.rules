rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verifica si el usuario autenticado es admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Función auxiliar: usuario autenticado
    function isAuth() {
      return request.auth != null;
    }

    // ── Colección: users ──
    // Cada usuario puede leer su propio doc. El admin puede leer y escribir todos.
    // Un usuario NO admin solo puede tocar de su propio doc el campo que el
    // portal escribe por él (mfaEnrolled, al activar el 2FA). Antes podía
    // escribir el doc completo y, con eso, ponerse role: 'admin' a sí mismo.
    // El alta (create) la hace el admin o la Cloud Function crearUsuario
    // (Admin SDK, que no pasa por estas reglas).
    match /users/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuth() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mfaEnrolled'])
      );
      allow delete: if isAdmin();
    }

    // ── Colección: reports (metadata de los informes) ──
    // Un cliente solo puede leer (get) los informes que tiene asignados en
    // userAccess/{uid}.reportIds; listar la colección es solo del admin. Antes
    // cualquier usuario con login podía listar todos y obtener su storagePath.
    // Si userAccess/{uid} no existe, el get() falla y la regla niega (el portal
    // lo tolera). Solo el admin puede crear/modificar/eliminar.
    match /reports/{reportId} {
      allow get:   if isAdmin() || (isAuth() &&
        reportId in get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('reportIds', []));
      allow list:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── Colección: folders (carpetas para organizar informes) ──
    // Todos los usuarios autenticados pueden leer (para navegar el árbol de
    // carpetas). Solo el admin puede crear / modificar / eliminar carpetas.
    match /folders/{folderId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Colección: clientDocs (documentos subidos por los usuarios cliente) ──
    // Cada usuario crea documentos a su nombre y puede leer/borrar los suyos.
    // El admin puede leer y borrar los de todos.
    match /clientDocs/{docId} {
      allow read:          if isAuth() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create:        if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ── Colección: publicLinks (enlaces públicos a informes) ──
    // Lectura de UN enlace (get) abierta a cualquiera (sin login): así el enlace
    // público funciona desde cualquier navegador conociendo su token. Listar la
    // colección es solo del admin: si no, cualquiera podía obtener las URLs de
    // todos los enlaces. El documento guarda la URL de descarga (pública por su
    // token) y el nombre del informe; nunca la clave de un informe encriptado.
    // Crear / eliminar: solo el admin.
    // Actualizar: el admin puede todo; un visitante anónimo SOLO puede sumar 1
    // al contador de accesos y refrescar la fecha del último acceso (no puede
    // tocar la URL, el nombre ni desactivar el enlace).
    match /publicLinks/{token} {
      allow get:    if true;
      allow list:   if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hitCount', 'lastAccessAt']) &&
        request.resource.data.hitCount == resource.data.get('hitCount', 0) + 1
      );
    }

    // ── Colección: userAccess ──
    // Cada usuario puede leer sus propios permisos.
    // Solo el admin puede escribir (asignar/quitar acceso).
    match /userAccess/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Colección: sessions (métricas de acceso) ──
    // Cada usuario crea su propia sesión y puede actualizar solo la suya
    // (latido / cierre). Solo el admin puede leer las métricas.
    match /sessions/{sid} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }

    // ── Configuración del portal (config/correos: plantillas de correo,
    // remitente, Reply-To y ventana de agrupado). Solo admins leen y escriben.
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Colección: mailLog (registro de envíos de correo) ──
    // Guarda direcciones de correo (dato personal): solo la leen los admins.
    // Solo la escribe el backend (Admin SDK); se purga sola por TTL (expiraEn).
    match /mailLog/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Colas internas del backend (avisos agrupados y tope de pedidos de
    // restablecimiento). Nadie las toca desde el navegador.
    match /avisosPendientes/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /limitesCorreo/{id} {
      allow read, write: if false;
    }

    // ── Colección: dashboardEvents (analítica de uso dentro de los informes) ──
    // Cada usuario crea sus propios eventos; solo el admin puede leerlos.
    match /dashboardEvents/{eid} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }
  }
}
