rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verifica si el usuario autenticado es admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Función auxiliar: usuario autenticado
    function isAuth() {
      return request.auth != null;
    }

    // ── Colección: users ──
    // Cada usuario puede leer su propio doc. El admin puede leer y escribir todos.
    match /users/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAuth() && (request.auth.uid == uid || isAdmin());
    }

    // ── Colección: reports (metadata de los HTMLs) ──
    // Todos los usuarios autenticados pueden leer (para mostrar nombre/fecha).
    // Solo el admin puede crear/modificar/eliminar.
    match /reports/{reportId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Colección: folders (carpetas para organizar informes) ──
    // Todos los usuarios autenticados pueden leer (para navegar el árbol de
    // carpetas). Solo el admin puede crear / modificar / eliminar carpetas.
    match /folders/{folderId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Colección: clientDocs (documentos subidos por los usuarios cliente) ──
    // Cada usuario crea documentos a su nombre y puede leer/borrar los suyos.
    // El admin puede leer y borrar los de todos.
    match /clientDocs/{docId} {
      allow read:          if isAuth() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create:        if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ── Colección: publicLinks (enlaces públicos a informes) ──
    // Lectura ABIERTA a cualquiera (sin login): así el enlace público funciona
    // desde cualquier navegador. El documento solo guarda la URL de descarga
    // (ya pública por su token) y el nombre del informe.
    // Crear / eliminar: solo el admin.
    // Actualizar: el admin puede todo; un visitante anónimo SOLO puede sumar 1
    // al contador de accesos y refrescar la fecha del último acceso (no puede
    // tocar la URL, el nombre ni desactivar el enlace).
    match /publicLinks/{token} {
      allow read:   if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hitCount', 'lastAccessAt']) &&
        request.resource.data.hitCount == resource.data.get('hitCount', 0) + 1
      );
    }

    // ── Colección: userAccess ──
    // Cada usuario puede leer sus propios permisos.
    // Solo el admin puede escribir (asignar/quitar acceso).
    match /userAccess/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Colección: sessions (métricas de acceso) ──
    // Cada usuario crea su propia sesión y puede actualizar solo la suya
    // (latido / cierre). Solo el admin puede leer las métricas.
    match /sessions/{sid} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }

    // ── Colección: dashboardEvents (analítica de uso dentro de los informes) ──
    // Cada usuario crea sus propios eventos; solo el admin puede leerlos.
    match /dashboardEvents/{eid} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }

    // ── Colección: mail (cola de la extensión Trigger Email) ──
    // Sólo la Cloud Function (Admin SDK) escribe acá; el Admin SDK NO pasa por
    // estas reglas. Bloqueamos TODO acceso de clientes: nadie puede leer la cola
    // ni encolar correos arbitrarios desde el navegador (anti-spam / anti-abuso).
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Colección de plantillas de la extensión (no la usamos, pero la dejamos
    // cerrada por las dudas).
    match /templates/{tplId} {
      allow read, write: if false;
    }
  }
}
