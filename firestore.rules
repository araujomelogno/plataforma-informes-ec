rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verifica si el usuario autenticado es admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Función auxiliar: usuario autenticado
    function isAuth() {
      return request.auth != null;
    }

    // ── Colección: users ──
    // Cada usuario puede leer su propio doc. El admin puede leer y escribir todos.
    match /users/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAuth() && (request.auth.uid == uid || isAdmin());
    }

    // ── Colección: reports (metadata de los HTMLs) ──
    // Todos los usuarios autenticados pueden leer (para mostrar nombre/fecha).
    // Solo el admin puede crear/modificar/eliminar.
    match /reports/{reportId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Colección: publicLinks (enlaces públicos a informes) ──
    // Lectura ABIERTA a cualquiera (sin login): así el enlace público funciona
    // desde cualquier navegador. El documento solo guarda la URL de descarga
    // (ya pública por su token) y el nombre del informe. Solo el admin crea o
    // elimina estos enlaces.
    match /publicLinks/{token} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Colección: userAccess ──
    // Cada usuario puede leer sus propios permisos.
    // Solo el admin puede escribir (asignar/quitar acceso).
    match /userAccess/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Colección: sessions (métricas de acceso) ──
    // Cada usuario crea su propia sesión y puede actualizar solo la suya
    // (latido / cierre). Solo el admin puede leer las métricas.
    match /sessions/{sid} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }

    // ── Colección: dashboardEvents (analítica de uso dentro de los informes) ──
    // Cada usuario crea sus propios eventos; solo el admin puede leerlos.
    match /dashboardEvents/{eid} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }
  }
}
