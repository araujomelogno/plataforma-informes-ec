# ────────────────────────────────────────────────────────────────────────────
# Parámetros NO secretos de la extensión "Trigger Email from Firestore"
# (firebase/firestore-send-email). Se versionan para que la config sea
# reproducible con:  firebase deploy --only extensions
#
# Los DATOS SENSIBLES (usuario/clave SMTP) NO van acá: se cargan como secreto
# al instalar/configurar la extensión (ver docs/correos-trigger-email.md).
# La cadena de conexión SMTP se guarda en el secreto SMTP_PASSWORD/SMTP_CONNECTION_URI
# de Secret Manager, no en este archivo.
# ────────────────────────────────────────────────────────────────────────────

# Colección que la extensión observa. DEBE coincidir con MAIL_COLLECTION de la
# Cloud Function notifyNewReportAccess (functions/index.js).
MAIL_COLLECTION=mail

# Remitente por defecto. Debe ser una casilla/alias válido del dominio
# equipos.com.uy autorizado a enviar por el SMTP de Google Workspace.
DEFAULT_FROM=Equipos Consultores - Portal de Informes <no-responder@equipos.com.uy>

# (Opcional) Responder-a para las respuestas de los usuarios.
DEFAULT_REPLY_TO=no-responder@equipos.com.uy

# Colección de plantillas Handlebars (no la usamos: el HTML lo arma la Cloud
# Function). Se deja el valor por defecto de la extensión.
TEMPLATES_COLLECTION=templates

# TTL: borra los documentos de la colección `mail` N días después de enviarlos.
# 0 = no borrar. 7 días mantiene la colección liviana conservando el historial reciente.
TTL_EXPIRE_TYPE=day
TTL_EXPIRE_VALUE=7

# Ubicación de Firestore (y de las funciones de la extensión). DEBE coincidir
# con la región real de tu base de Firestore (Firebase Console → Firestore
# Database → arriba figura la ubicación). Descomentá y ajustá el valor correcto,
# p. ej.: nam5, us-central, southamerica-east1, etc. Si lo dejás comentado, el
# instalador te lo va a preguntar.
# DATABASE_REGION=nam5

# El host/puerto SMTP van en la cadena de conexión (secreto SMTP_CONNECTION_URI,
# se carga al instalar la extensión, NO en este archivo). Para Google Workspace:
#   - SMTP relay:            smtps://smtp-relay.gmail.com:465
#   - Cuenta + App Password: smtps://usuario%40equipos.com.uy:APP_PASSWORD@smtp.gmail.com:465
